# Install to /etc/systemd/system/mojorack-kiosk.service on the Pi driving the
# 7" screen, then: sudo systemctl enable --now mojorack-kiosk
[Unit]
Description=Mojorack cyberpunk network dashboard kiosk
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=DASHBOARD_URL=http://localhost:3010
ExecStart=/home/pi/mojorack/kiosk/kiosk.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical.target
