# Copy to .env and fill in. Never commit the real .env file.

# URL of your UniFi controller (UDM/UDM Pro/Cloud Key/self-hosted controller).
# Example: https://192.168.1.1 or https://192.168.1.10:8443
UNIFI_CONTROLLER_URL=https://192.168.1.1

# Use a LOCAL admin account on the controller, not a ui.com cloud account.
# Cloud accounts require MFA and will not work for automated polling.
UNIFI_USER=mojorack-poller
UNIFI_PASS=changeme
